rules_version = '2';

// Sicherheitsregeln für Firestore.
// Grundsatz: NUR eingeloggte Benutzer dürfen lesen und schreiben.
// Da alle Benutzer Mitarbeiter der Praxis sind, teilen sie sich Produkte
// und History.
service cloud.firestore {
  match /databases/{database}/documents {

    // Angemeldet = Mitarbeiter mit gültigem Konto.
    function signedIn() {
      return request.auth != null;
    }

    // Admin-Account: darf als Einziger die History löschen.
    // Muss mit ADMIN_EMAIL in src/constants.js übereinstimmen.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'office@azj.at';
    }

    // Produkte: gemeinsame Liste, jeder eingeloggte Mitarbeiter darf alles.
    match /products/{productId} {
      allow read, write: if signedIn();
    }

    // History: jeder eingeloggte Mitarbeiter darf lesen und Verkäufe anlegen,
    // aber NUR der Admin darf löschen (Monats-Reset). Ändern ist nicht nötig.
    match /history/{entryId} {
      allow read, create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
