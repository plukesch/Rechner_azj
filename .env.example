# Firebase Web-App Konfiguration
# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Diese Werte findest du in der Firebase Console:
#   Projekt-Einstellungen  ->  Allgemein  ->  Meine Apps  ->  Web-App  ->  SDK-Konfiguration
#
# Die .env-Datei wird NICHT ins Git eingecheckt (steht in .gitignore).
# Bei Vercel trägst du dieselben Variablen später unter "Environment Variables" ein.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Zugangscode für die Registrierung (nur wer diesen kennt, kann sich registrieren)
VITE_REGISTER_ACCESS_CODE=AZJ-2026

# Admin-Account, der als Einziger die History löschen darf ("Monat abschließen").
# Optional – wird dieser Wert weggelassen, gilt der Standard office@azj.at.
# ACHTUNG: Bei Änderung auch in firestore.rules anpassen!
VITE_ADMIN_EMAIL=office@azj.at
